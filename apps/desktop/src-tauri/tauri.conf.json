{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pimp my DSH",
  "mainBinaryName": "Pimp my DSH",
  "version": "0.1.0",
  "identifier": "io.github.koopmannleon19977-cmyk.pimp-my-dsh",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pimp my DSH",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["runtime/"],
    "category": "DeveloperTool",
    "shortDescription": "Windows tray supervisor for DeepSeek Harness",
    "longDescription": "A Windows-first tray supervisor that launches and manages the pimp-my-dsh DeepSeek Harness distribution.",
    "copyright": "Copyright (c) 2026 pimp-my-dsh contributors. MIT License.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Pimp my DSH",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer.nsh",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
