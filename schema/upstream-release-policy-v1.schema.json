{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koopmannleon19977-cmyk/pimp-my-dsh/schema/upstream-release-policy-v1.schema.json",
  "title": "pimp-my-dsh upstream release policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "currentPin", "monitoring", "plannedRepin", "securityFixes", "lastReviewed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "currentPin": { "type": "string", "minLength": 1 },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "intervalDays", "scope"],
      "properties": {
        "cadence": { "const": "weekly" },
        "intervalDays": { "const": 7 },
        "scope": { "const": "all direct @deepseek-ai/dsh packages" }
      }
    },
    "plannedRepin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "intervalDays", "requiresSinglePin", "requiredChecks"],
      "properties": {
        "cadence": { "const": "monthly" },
        "intervalDays": { "const": 30 },
        "requiresSinglePin": { "const": true },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "securityFixes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response", "requiresSinglePin"],
      "properties": {
        "response": { "const": "immediate" },
        "requiresSinglePin": { "const": true }
      }
    },
    "lastReviewed": { "type": "string", "format": "date" }
  }
}
