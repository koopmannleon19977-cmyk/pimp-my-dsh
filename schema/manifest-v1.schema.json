{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koopmannleon19977-cmyk/pimp-my-dsh/schema/manifest-v1.schema.json",
  "title": "pimp-my-dsh distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleVersion", "upstreamVersion", "profile"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleVersion": { "const": "0.1.0" },
    "upstreamVersion": { "const": "0.1.0-rc.6" },
    "profile": {
      "enum": ["coding", "safe", "research", "windows", "headless", "personal", "experimental", "web"]
    }
  }
}
